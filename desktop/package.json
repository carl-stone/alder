{
  "name": "@alder/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Alder's thin sandboxed Electron desktop shell",
  "author": "Alder contributors",
  "main": ".vite/build/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron-forge start",
    "build": "tsc -p tsconfig.json --noEmit && electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "env-paths": "4.0.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "22.19.15",
    "@types/proper-lockfile": "4.1.4",
    "electron": "44.2.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
