{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "scripts/**/*.mts",
    "*.config.ts",
    "../host/src/protocol.ts",
    "../host/src/resources.ts",
    "../host/src/processes.ts",
    "../host/src/diagnostics.ts",
    "../host/src/sessions.ts"
  ]
}
