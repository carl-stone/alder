+
+#' Publish a MIME bundle through Ark's public Jupyter display hook.
+#'
+#' @param data_json Scalar UTF-8 JSON object containing MIME data.
+#' @param metadata_json Scalar UTF-8 JSON metadata object.
+#' @param transient_json Scalar UTF-8 JSON transient data object.
+#' @export
+ark_publish_mimebundle <- function(data_json, metadata_json = "{}", transient_json = "{}") {
+    invisible(.ps.Call("ark_publish_mimebundle", data_json, metadata_json, transient_json))
+}
